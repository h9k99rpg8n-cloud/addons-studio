    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.4.0",
    "happy-dom": "^20.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
